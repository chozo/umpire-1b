{
  "name": "umpire-1b",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5289",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "node tools/e2e.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "ogp": "node tools/ogp/make-ogp.mjs",
    "promo": "npm run build && node tools/promo/record.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.152.0"
  }
}
